# RepoMind backend configuration.
#
# Copy to backend/.env and fill in real values:
#     cp backend/.env.example backend/.env
#
# backend/.env is git-ignored and must never be committed. This file lists
# every variable the app reads; anything omitted here falls back to the
# default in backend/app/core/config.py.

# --- Database ---------------------------------------------------------------
# Postgres connection string. On Render use the *internal* database URL.
DATABASE_URL=postgresql://user:password@host:5432/repomind

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<64-hex-characters>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS -------------------------------------------------------------------
# Exact origin of the deployed frontend (no trailing slash).
FRONTEND_URL=http://localhost:5173

# development | production. production marks the refresh cookie Secure, so only
# set it once the site is actually served over HTTPS.
ENVIRONMENT=development

# --- Feature gates ----------------------------------------------------------
# false takes the chat (LLM) endpoints offline without removing them: the
# ask/stream routes return 503 while chat history stays readable. Start
# production with false until the prompt/error handling is hardened.
CHAT_ENABLED=true

# --- Rate limiting ----------------------------------------------------------
# In-process sliding-window limiter on the auth routes (login/register/refresh).
# Counters live in one worker's memory, so running more than one uvicorn worker
# or instance multiplies the effective budget; move the store to something
# shared (Redis) before scaling out. The numeric budgets live in config.py.
#
# Client address: the per-IP budgets key on CLIENT_IP_HEADER when set, and on
# the socket peer otherwise.
#   * On Render all traffic arrives via Cloudflare, which sets CF-Connecting-IP
#     to the real client and overwrites anything a client sends, so set
#     CLIENT_IP_HEADER=cf-connecting-ip there.
#   * Leave it blank when the app is directly reachable (local dev).
#   * Only point it at a header your edge controls. x-forwarded-for is NOT such
#     a header: its leftmost entry is whatever the client sent. (And do not
#     instead set FORWARDED_ALLOW_IPS="*" to make uvicorn read it - that trusts
#     the same forgeable value; Render's guide calls it a critical
#     vulnerability.)
# Both mistakes hurt: unset behind a proxy, every request reports the proxy and
# one shared bucket means a few failed logins lock out everyone; forgeable, and
# the per-IP budget is evaded at will. The per-account login budget keys on the
# submitted username, so it holds either way.
RATE_LIMIT_ENABLED=true
CLIENT_IP_HEADER=

# --- LLM --------------------------------------------------------------------
# groq | nvidia
LLM_PROVIDER=groq
NVIDIA_API_KEY=<your-nvidia-api-key>
GROQ_API_KEY=<your-groq-api-key>

# Optional; only needed if LLM_PROVIDER is switched to an OpenAI model.
OPENAI_API_KEY=

# --- Embeddings -------------------------------------------------------------
# gemini | huggingface | local
# Switching backends changes the vector dimensions, so repositories indexed
# with the previous backend must be reprocessed before they can be queried.
EMBEDDING_BACKEND=gemini

# Gemini Developer API (default). Create a key at:
#     https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Gemini supports 128-3072; 1536 balances quality and storage.
GEMINI_EMBEDDING_DIMENSIONS=1536

# Hugging Face Inference API (only used when EMBEDDING_BACKEND=huggingface).
# Create a read token with inference access at:
#     https://huggingface.co/settings/tokens
HF_TOKEN=<your-hugging-face-token>
HF_INFERENCE_PROVIDER=hf-inference

# Model for the huggingface/local backends. For local, the model is downloaded
# and loaded in-process on first use.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunks per embedding request. Lower it if an API rejects large batches.
EMBEDDING_BATCH_SIZE=100
